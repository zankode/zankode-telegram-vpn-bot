# Zankode VPN v2.2.1
# Copy this file to .env and fill in private values. Never commit .env.

BOT_TOKEN=
ADMIN_USER_ID=0
DB_FILE=config_shop.db

# ==================== 3X-UI integration ====================
# Include the panel base path if you use one, for example:
# https://panel.example.com/secret-path
XUI_PANEL_URL=

# Recommended for current 3X-UI: create a dedicated API Token in the panel Authentication/API Token settings
XUI_API_TOKEN=

# modern = 3X-UI v3.x Clients API (recommended)
# legacy = older X-UI/3X-UI cookie login API
# auto = prefer token when present, otherwise legacy credentials
XUI_API_MODE=modern

# Used only by legacy mode / older panels
XUI_USERNAME=
XUI_PASSWORD=

# Keep TLS verification enabled in production.
XUI_VERIFY_TLS=1
XUI_TIMEOUT=15

# Optional public subscription URL delivered after provisioning.
# If omitted in modern mode, Zankode falls back to panel-generated client links.
# Recommended explicit template:
# XUI_SUB_URL_TEMPLATE=https://sub.example.com/sub/{sub_id}
# You can also use {email} if your subscription setup needs it.
XUI_SUB_URL_TEMPLATE=

# Alternative shorthand; when the template is empty Zankode builds:
#   XUI_SUB_BASE_URL + /sub/{sub_id}
XUI_SUB_BASE_URL=

# Optional flow override. Leave blank unless all target inbounds are known to need the same flow.
XUI_DEFAULT_FLOW=
